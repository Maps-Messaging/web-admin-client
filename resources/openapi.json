      "EndPointSummaryDTO": {
        "title": "End Point Information",
        "required": [
          "adapter",
          "bytesRead",
          "bytesWritten",
          "connectedTimeMs",
          "id",
          "lastRead",
          "lastWrite",
          "name",
          "overFlow",
          "protocolName",
          "protocolVersion",
